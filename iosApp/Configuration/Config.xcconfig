// Shared settings of the iOS app. Set TEAM_ID to sign for a device; the simulator needs none.
TEAM_ID=
BUNDLE_ID=io.github.beppe2880.opencodemobile
APP_NAME=OpenCode Mobile
// Bumped by release-please, like version.txt.
MARKETING_VERSION=0.11.0 // x-release-please-version
// App Group shared with the widget extension; on a device it must be enabled for TEAM_ID.
APP_GROUP=group.$(BUNDLE_ID)
