<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Dictation in the composer; asked only when the microphone button is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets SpeechRecognizer find the system speech service on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transcript-exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/transcript_export_paths" />
        </provider>
    </application>
</manifest>
